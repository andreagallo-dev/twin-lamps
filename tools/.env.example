# Private settings for update_lamp.sh.
# Copy this file to .env (same folder, ignored by git) and put your own values in it.

# SSH user and host of the server that publishes the firmware with Tailscale Funnel
SERVER=user@your-server

# Folder on the server published by Tailscale Funnel (see server/OTA_HOSTING.md)
FW_DIR=/srv/lamps-fw

# MQTT broker and user (the password is asked when the script runs)
MQTT_HOST=your-deployment.emqxsl.com
MQTT_USER=your-mqtt-user

# Same value as SECRET_TOPIC_BASE in secrets.h, ending with "/"
TOPIC_BASE=lampade/your-secret-channel/
