# Private values for docker-compose.yml.
# Copy this file to .env (same folder, ignored by git), or paste these lines into the
# "Environment" box of your Compose UI. A "$" in the password must be written as "$$".
MQTT_HOST=your-deployment.emqxsl.com
MQTT_USER=your-mqtt-user
MQTT_PASS=your-mqtt-password
TOPIC_BASE=lampade/your-secret-channel/
